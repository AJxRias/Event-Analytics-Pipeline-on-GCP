# Local
PIPELINE_TARGET=duckdb
SCAN_API_URL=http://127.0.0.1:8000
SCAN_API_KEY=local-dev-key
PII_SALT=change-me

# GCP (used when PIPELINE_TARGET=bigquery and by deploy/*.sh)
